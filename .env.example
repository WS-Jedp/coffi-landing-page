# Coffi Landing — Environment Variables Template
# Copy this file to .env.local for local development.

# CARTO Basemaps key for the map-intro section.
# Free, no account and no card, 5M tiles/month: https://carto.com/basemaps/apikey/
# Without it CARTO serves watermarked tiles that read "API KEY REQUIRED".
# NEXT_PUBLIC_ is inlined into the client bundle at build time — this key is
# public by design, so restrict it by origin in the CARTO dashboard if needed.
NEXT_PUBLIC_MAP_TILE_KEY=your-carto-key
